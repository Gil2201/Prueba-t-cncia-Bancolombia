  <ifrs_2:ProportionOfVotingRightsHeldInJointVenture decimals="1" contextRef="C825500Y2_Duration_EntitysTotalForJointVenturesMember" unitRef="pure">0.5</ifrs_2:ProportionOfVotingRightsHeldInJointVenture>
