: 8.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;-&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid #BFBFBF 1.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 12.02%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 8.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;-&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="border: none; border-bottom: solid #BFBFBF 1.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 10.34%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 8.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;26.253.069&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid #BFBFBF 1.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 12.38%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 8.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;-&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 1.0pt"&gt;&lt;td style="border: none; border-bottom: solid #BFBFBF 1.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 39.34%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 8.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Diferencia en cambio no realizada&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid #BFBFBF 1.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 14.7%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 8.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-seri