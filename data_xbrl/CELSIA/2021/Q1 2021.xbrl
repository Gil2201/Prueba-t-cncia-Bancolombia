402 3.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 63.6%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: white"&gt;Total gastos de administración&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="background: #767171; border: none; border-bottom: solid #EE7402 3.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 18.2%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: white"&gt;75.006.579&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="background: #767171; border: none; border-bottom: solid #EE7402 3.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 18.2%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: white"&gt;65.457.615&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 11.0pt; margin-bottom: 4.0pt; margin-left: 0cm; margin-right: 0cm; margin-top: 0cm; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;El crecimiento de los gastos de administración obedece principalmente a:&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 11.0pt; margin-bottom: 4.0pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; font-family: Symbol"&gt;·&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;        &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Mayores gastos de personal en 2021 frente al mismo periodo de 2020 debido principalmente al reconocimiento de bonificaciones a empleados.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 11.0pt; margin-bottom: 4.0pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; font-family: Symbol"&gt;·&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;        &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Deterioro de cuentas comerciales por cobrar ocasionada por la condición actual de contingencia por el COVID 19 que se focaliza en los estratos en los cuales se han presentado menores porcentajes de recaudo.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 11.0pt; margin-bottom: 4.0pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; font-family: Symbol"&gt;·&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;        &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Amortizaciones en sistemas de información, &lt;span class="normaltextrun"&gt;&lt;span style="background: white"&gt;que dentro de los más relevantes se encuentra el software del sistema de información comercial &#8211; Esfera.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</ifrs:DisclosureOfGeneralAndAdministrativeExpenseExplanatory>
  <ifrs:DisclosureOfInvestmentsAccountedForUsingEquityMethodExplanatory contextRef="p3">&lt;p class="NotesHeading" style="margin-bottom: 4.0pt; margin-left: 0cm; margin-right: 0cm; margin-top: 0cm"&gt;&lt;span style="font-size: 12.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: #EE7402"&gt;NOTA 18. Método de participación patrimonial&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: 4.0pt; page-break-after: avoid; text-indent: 7.1pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Al 31 de marzo, el saldo del método de participación en los resultados del periodo y en otros resultados intégrales, comprendía:&lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="100%" style="border-collapse: collapse; width: 100.0%"&gt;&lt;tbody&gt;&lt;tr style="height: 1.0pt"&gt;&lt;td valign="bottom" style="border: none; border-bottom: solid #EE7402 3.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 25.04%"/&gt;&lt;td valign="bottom" style="border-bottom: solid #EE7402 3.0pt; border-left: none; border-right: solid #E7E6E6 1.0pt; border-top: none; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 25.0%"/&gt;&lt;td colspan="4" style="border-bottom: solid #EE7402 3.0pt; border-left: none; border-right: solid #E7E6E6 1.0pt; border-top: solid #E7E6E6 1.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;Acumulado&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 1.0pt"&gt;&lt;td rowspan="2" style="border: none; border-left: solid #E7E6E6 1.0pt; height: 1.0pt; pa