f&amp;quot;; color: black"&gt;                        -&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid #EE7402 1.5pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 13.08%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 8.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;                        -&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid #EE7402 1.5pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 11.9%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 8.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;143.800&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoListParagraphCxSpFirst" style="margin: 0cm; margin-bottom: .0001pt; page-break-after: avoid; text-align: justify"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt; &lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpLast" style="margin: 0cm; margin-bottom: .0001pt; page-break-after: avoid; text-align: justify"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Restricciones y compromisos significativos&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt; margin-left: 0cm; margin-right: 0cm; margin-top: 6.0pt; text-align: justify; text-indent: 8.5pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;No existen restricciones significativas sobre la capacidad de los negocios conjuntos y compañías asociadas para transferir fondos por dividendos, reembolso de préstamos, anticipos u otros. Asimismo, no se tienen compromisos no reconocidos con negocios conjuntos y compañías asociadas a 31 de marzo de 2021 y 31 de diciembre de 2020, que puedan dar lugar a salidas de efectivo u otros recursos en el futuro, tales como: aportación de fondos o recursos, compromisos de préstamos o apoyo financiero, compromisos de adquirir una participación en la asociada o negocio conjunto de otra parte.&lt;/span&gt;&lt;/p&gt;</ifrs:DisclosureOfInterestsInOtherEntitiesExplanatory>
  <ifrs:DisclosureOfCashAndCashEquivalentsExplanatory contextRef="p3">&lt;p class="MsoNormal" style="margin-bottom: 4.0pt; page-break-after: avoid; text-align: justify"&gt;&lt;b&gt;&lt;span style="font-size: 12.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: #EE7402; text-transform: uppercase"&gt;NOTA 9. EFECTIVO Y EQUIVALENTES AL EFECTIVO&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: 4.0pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;El saldo de efectivo y equivalentes al efectivo, al 31 de marzo y 31 diciembre, comprendía:&lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="100%" style="border-collapse: collapse; width: 100.0%"&gt;&lt;tbody&gt;&lt;tr style="height: 1.0pt"&gt;&lt;td style="border: none; border-bottom: solid #EE7402 3.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 61.74%"/&gt;&lt;td style="background: #EE7402; border: none; border-bottom: solid #EE7402 3.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 18.9%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: white"&gt;Marzo 2021&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid #EE7402 3.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 19.36%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;Diciembre 2020&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 1.0pt"&gt;&lt;td s