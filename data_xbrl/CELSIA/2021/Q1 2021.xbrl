l&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;Arrendamientos&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid #E7E6E6 1.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 2.82%"/&gt;&lt;td style="background: #E7E6E6; border: none; border-bottom: solid #E7E6E6 1.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 18.92%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;1.106.062&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid #E7E6E6 1.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 18.92%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;574.568&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 1.0pt"&gt;&lt;td style="background: #767171; border: none; border-bottom: solid #EE7402 3.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 59.34%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: white"&gt;Total costo de venta&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="background: #767171; border: none; border-bottom: solid #EE7402 3.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 2.82%"/&gt;&lt;td style="background: #767171; border: none; border-bottom: solid #EE7402 3.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 18.92%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: white"&gt;665.684.128&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="background: #767171; border: none; border-bottom: solid #EE7402 3.0pt; height: 1.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 18.92%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: white"&gt;622.159.191&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: 4.0pt; text-align: justify; text-indent: 7.1pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Los costos consolidados reflejan un aumento de $43.524.937, es decir un 7% adicional frente a marzo de 2020. Los costos de Colombia crecieron un 17% por las mayores compras de energía y costos de peajes del comercializador (incremento en la demanda), así como, el aumento del CERE por la mayor generación y tasa representativa del mercado. En Centroamérica los costos de ventas presentan una disminución de USD 12 millones frente a 2020, principalmente por el menor consumo de carbón debido a la declaración de indisponibilidad de BLM del sistema y, a las menores compras de energía dada la mayor generación de las hídricas.&lt;/span&gt;&lt;/p&gt;</ifrs:DisclosureOfCostOfSalesExplanatory>
  <ifrs:DisclosureOfOtherOperatingIncomeExpenseExplanatory contextRef="p3">&lt;p class="MsoNormal" style="margin-bottom: 4.0pt; page-break-after: avoid; text-align: justify"&gt;&lt;b&gt;&lt;span style="font-size: 12.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: #EE7402; text-transform: uppercase"&gt;NOTA 16. otros ingresos (gastos), neto&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: 4.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;Al 31 de marzo, el saldo de otros ingresos (gastos), comprendía:&lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="100%" style="border-collapse: collapse; width: 100.0%"&gt;&lt;thead&gt;&lt;tr style="height: 1.2pt"&gt;&lt;td valign="bottom" style="border: none; border-bottom: solid #EE7402 3.0pt; height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 61.44%"/&gt;&lt;td style="border: none; border-bottom: solid #EE7402 3.0pt; height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 1.66%"/&gt;&lt;td style="background: #EE7402; border: none; border-bottom: solid #EE7402 3.0pt; height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 19.08%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: white"&gt;Marzo 2021&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid #EE7402 3.0pt; height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 17.82%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;qu