t 0cm 3.5pt; white-space: nowrap; width: 20.9%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: white"&gt;    18.071.636&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="background: #767171; border: none; border-bottom: solid #EE7402 3.0pt; height: 9.25pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 19.96%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: white"&gt;14.388.105&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoBodyTextIndent" style="margin: 0cm; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin-bottom: .0001pt; margin-left: 14.2pt; margin-right: 0cm; margin-top: 0cm; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;(1)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Los pagos por honorarios corresponden a los pagos por asistencia a reuniones de la Junta Directiva y los comités de apoyo para su gestión.&lt;/span&gt;&lt;/p&gt;</ifrs:DisclosureOfTransactionsBetweenRelatedPartiesExplanatory>
  <ifrs_2:DisclosureOfAdditionalInformationExplanatory contextRef="p3">&lt;p class="NotesHeading" style="margin-bottom: 4.0pt; margin-left: 0cm; margin-right: 0cm; margin-top: 6.0pt; text-align: justify"&gt;&lt;span style="font-size: 12.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: #EE7402; text-transform: none"&gt;NOTA 24&lt;/span&gt;&lt;span style="font-size: 12.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: #EE7402"&gt;. reclasificación de partidas en los estados financieros&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin-bottom: .0001pt"&gt; &lt;/p&gt;&lt;p class="MsoListParagraph" style="line-height: 11.0pt; margin-bottom: 4.0pt; margin-left: 18.75pt; margin-right: 0cm; margin-top: 0cm; text-align: justify; text-indent: -18.75pt"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;24.1&lt;/span&gt;&lt;/b&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Presentación de ingresos y gastos financieros&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt; text-align: justify; text-indent: 14.2pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;"&gt;Respecto del periodo intermedio terminado al 31 de marzo de 2020, se reclasifican cuentas de resultados entre rubros que no afectan los subtotales de la utilidad antes de impuestos para fines de comparación, tal como se muestra a continuación en el estado de resultados y en la nota respectiva afectando los ingresos, gastos financieros y diferencia en cambio:&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin-bottom: 4.0pt; margin-left: 0cm; margin-right: 0cm; margin-top: 0cm; text-align: justify; text-indent: 8.5pt"&gt; &lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="98%" style="border-collapse: collapse; width: 98.32%"&gt;&lt;thead&gt;&lt;tr style="height: 9.9pt"&gt;&lt;td style="border: none; border-bottom: solid #EE7402 3.0pt; height: 9.9pt; padding: 0cm 0cm 0cm 0cm; width: 58.08%"/&gt;&lt;td style="background: #EE7402; border: none; border-bottom: solid #EE7402 3.0pt; height: 9.9pt; padding: 0cm 0cm 0cm 0cm; white-space: nowrap; width: 25.82%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: white"&gt;Marzo 2020 con reclasificación&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid #EE7402 3.0pt; height: 9.9pt; padding: 0cm 0cm 0cm 0cm; white-space: nowrap; width: 16.08%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;Marzo 2020&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr style="height: 9.9pt"&gt;&lt;td style="border: none; border-bottom: solid #D9D9D9 1.0pt; height: 9.9pt; padding: 0cm 0cm 0cm 0cm; width: 58.08%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,&amp;quot;sans-serif&amp;quot;; color: black"&gt;Ingresos operacionales&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="border: none; border-bottom: solid #D9D9D9 1.0pt; height: 9.9pt; padding: 0cm 0cm 0cm 0cm; white-space: nowrap; width: 25.82%"/&gt;&lt;td valign="top" style="border: none; border-bottom: solid #D9D9D9 1.0pt; height: 9.9pt; padding: 0cm 0cm 0cm 0cm; white-space: nowrap; width: 16.08%"/&gt;&lt;/tr&