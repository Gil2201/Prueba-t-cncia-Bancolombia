amp;quot;Arial&amp;quot;,sans-serif"&gt;384.672.034&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoNormal" style="line-height: 12.0pt; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="text-decoration: underline"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;&lt;span style="text-decoration: none"&gt; &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin-bottom: .0001pt; margin-left: 1.0cm; margin-right: 0cm; margin-top: 0cm; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;(1)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;El incremento en las cuentas bancarias de ahorros obedece principalmente a recursos recibidos del crédito otorgado por BANCOLOMBIA Panamá por $147.240.000.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin-bottom: .0001pt; margin-left: 1.0cm; margin-right: 0cm; margin-top: 0cm; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;(2)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;La disminución corresponde principalmente al pago realizado en el mes de enero por la contingencia de alumbrado público de Tuluá por $7.750 millones.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraph" style="margin-bottom: .0001pt; margin-left: 1.0cm; margin-right: 0cm; margin-top: 0cm; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;(3)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;El siguiente es el valor del efectivo y equivalente al efectivo restringido, no disponible para el uso:&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Al &lt;span style="color: black"&gt;31 de marzo de 2020 y 31 de diciembre de 2019&lt;/span&gt; Bahía Las Minas Corp. tiene fondos restringidos depositados en Banco General S.A. BG Trust por $18.727.360 (2019 - $20.836.350) los cuales forman parte del fideicomiso de garantía de la Emisión Pública de Bonos por USD$175.000.000; Alternegy tiene fondos restringidos depositados en Banco Banistmo S.A. por $109.915.569 (2019 - $67.121.929) que forman parte de garantía por la Emisión Pública de Bonos por USD$320.000.000 en diciembre 2017.&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Adicionalmente existen fondos restringidos por concepto de Plan 5 Caribe por $1.459.214 (2019, $997.165) y recursos para préstamo de vivienda del pacto colectivo por $887.740 (2019, $1.228.953).&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin: 0cm; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Adicionalmente existen fondos restringidos por concepto de recursos para:&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin: 0cm; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="100%" style="border-collapse: collapse; width: 100.0%"&gt;&lt;tbody&gt;&lt;tr style="height: 12.0pt"&gt;&lt;td valign="bottom" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 55.34%"/&gt;&lt;td valign="bottom" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 3.48%"/&gt;&lt;td valign="bottom" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 19.1%"&gt;&lt;p class="Tablas"&gt;Marzo 2020&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 2.24%"/&gt;&lt;td valign="bottom" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 19.86%"&gt;&lt;p class="Tablas"&gt;Diciembre 2019&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 12.0pt"&gt;&lt;td colspan="2" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Fidudavivienda Contrato FAER Tolima&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 19.1%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;             591.707&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 2.24%"/&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 19.86%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;1.008.500&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 12.0pt"&gt;&lt;td colspan="2" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Fiducoldex UPME Subestación Toluviejo&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 19.1%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;          1.051.926&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 2.24%"/&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 19.86%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;1.087.729&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 12.0pt"&gt;&lt;td colspan="2" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Plan complementario de salud&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 19.1%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;             528.115&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 2.24%"/&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 19.86%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;1.539.962&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 12.0pt"&gt;&lt;td colspan="2" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Fondo de vivienda para el sindicato&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 19.1%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;            &lt;/span&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;947.715&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 2.24%"/&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 19.86%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;1.187.219&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 12.0pt"&gt;&lt;td colspan="2" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Fondos proyectos activos Celsia Tolima&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 19.1%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;            &lt;/span&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;165.054&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 2.24%"/&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 19.86%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;7.464.792&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 12.75pt"&gt;&lt;td colspan="2" style="height: 12.75pt; padding: 0cm 3.5pt 0cm 3.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Fondos proyectos activos Celsia Colombia&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 12.75pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 19.1%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;            &lt;/span&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;166.809&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.75pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 2.24%"/&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 12.75pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 19.86%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;95.919&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 12.0pt"&gt;&lt;td colspan="2" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: justify"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Total equivalente de efectivo restringido (a)&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 19.1%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;         &lt;/span&gt;&lt;/b&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;3.451.326&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 2.24%"/&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 19.86%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;12.384.121&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoBodyTextIndent" style="margin: 0cm; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin-bottom: .0001pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;(a)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;La disminución en el efectivo y equivalentes de efectivo restringido obedece principalmente a la transferencia por $7.350 millones del PA de Activos como aporte a la inversión en proyectos.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin: 0cm; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;El uso de los fondos en estas cuentas se encuentra restringido al cumplimiento de los términos y condiciones de las fiducias.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Los fondos de inversión, carteras colectivas y fideicomisos son activos financieros medidos al valor razonable con cambio en los resultados,&lt;/span&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;adquiridos principalmente para negociar y generar utilidad a corto plazo.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt; text-align: justify"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Riesgo de emisor y contraparte:&lt;/span&gt;&lt;/b&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Mensualmente el Grupo aplica un modelo de cupos de emisor y contraparte con el fin de proponer la máxima exposición crediticia para las diferentes entidades financieras que cumplan los lineamientos establecidos. Estos cupos son monitoreados permanentemente y son aprobados por un comité, con el objetivo de alertar sobre posibles excesos de utilización de dichos límites. Al 31 de diciembre todas las entidades se encontraban dentro de los límites permitidos.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;La rentabilidad media del efectivo al corte del periodo fue &lt;span style="color: black"&gt;de&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;2,18%&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;(2&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;019 &#8211; &lt;span style="color: black"&gt;3,58% E.A).&lt;/span&gt; Actualmente, estos recursos se encuentran en entidades calificadas como mínimo en la categoría AA+ para riesgo de crédito y las contrapartes son vigiladas por la Superintendencia Financiera de Colombia.&lt;/span&gt;&lt;/p&gt;</ifrs:DisclosureOfCashAndCashEquivalentsExplanatory>
  <ifrs:DisclosureOfInventoriesExplanatory contextRef="p3">&lt;p class="Notas1"&gt;&lt;span class="Notas1Car"&gt;&lt;span&gt;NOTA 10. INVENTARIOS&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;El saldo de inventarios, neto, al&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;31 de diciembre&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;comprendía:&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="100%" style="border-collapse: collapse; width: 100.0%"&gt;&lt;tbody&gt;&lt;tr style="height: 12.0pt"&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 58.78%"/&gt;&lt;td valign="bottom" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 18.68%"&gt;&lt;p class="Tablas"&gt;Marzo 2020&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 4.6%"&gt;&lt;p class="Tablas"&gt; &lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 17.94%"&gt;&lt;p class="Tablas"&gt;Diciembre 2019&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 12.0pt"&gt;&lt;td valign="bottom" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 58.78%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Materiales y suministros (1)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 18.68%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;221.393.090&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 4.6%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 17.94%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;180.210.716&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoListParagraph" style="line-height: normal; margin-bottom: .0001pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; text-align: justify"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraph" style="line-height: normal; margin-bottom: .0001pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;(1)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Incluye inventario de gas y materiales para mantenimiento de las plantas e inventario mantenido por las sociedades de Centroamérica por $124.019.316 (2019 - $107.695.161). El&lt;/span&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;incremento en el inventario obedece principalmente a la compra de vehículos eléctricos para la venta, y a la compra de medidores, postes, cables y reconectores durante el periodo.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Al 31 de marzo&lt;span style="color: black"&gt;, el consumo de inventarios reconocido como costos de operación y proyectos asciende a $78.045.840&lt;/span&gt;&lt;span style="color: black"&gt;(2019 - $100.215.660).&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Estos inventarios no tienen restricciones ni gravámenes que limiten su realización o negociación.&lt;/span&gt;&lt;/p&gt;</ifrs:DisclosureOfInventoriesExplanatory>
  <ifrs:DisclosureOfShareCapitalReservesAndOtherEquityInterestExplanatory contextRef="p3">&lt;p class="Notas1"&gt;&lt;span class="Notas1Car"&gt;&lt;span style="text-transform: none"&gt;NOTA 11. PATRIMONIO&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;La composición del patrimonio, a 31 de marzo de 2020 y&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;31 de diciembre de 2019&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;es la siguiente:&lt;/span&gt;&lt;/p&gt;&lt;p class="Notas3"&gt;&lt;span&gt;Capital emitido&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraph" style="margin-left: 0cm; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;El capital autorizado de la compañía está representado en 1.200.000.000 acciones ordinarias de valor nominal de $0,25 por acción. En 2019, el capital suscrito y pagado asciende a $267.493 y el número de acciones en circulación es de 1.069.972.554. Cada acción confiere un voto a su accionista y el derecho a percibir dividendos.&lt;/span&gt;&lt;/p&gt;&lt;p class="Notas3"&gt;&lt;span&gt;Reservas&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraph" style="line-height: normal; margin: 0cm; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Las compañías están obligadas por ley a apropiar el 10% de sus utilidades netas anuales como reserva legal hasta que el saldo de esta reserva, que no puede distribuirse antes de la liquidación de la compañía, pero se puede utilizar para absorber o reducir pérdidas, sea equivalente por lo menos al 50% del capital suscrito. Las compañías pueden disponer del exceso de este monto para las apropiaciones, de acuerdo con lo que autorice la Asamblea de Accionistas.&lt;/span&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;A 31 diciembre&lt;/span&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;, esta reserva alcanza el monto mínimo exigido:&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin-bottom: .0001pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; text-align: justify"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="100%" style="border-collapse: collapse; width: 100.0%"&gt;&lt;tbody&gt;&lt;tr style="height: 11.35pt"&gt;&lt;td valign="bottom" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 54.16%"/&gt;&lt;td valign="bottom" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 20.36%"&gt;&lt;p class="Tablas"&gt;Marzo 2020&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 3.4%"&gt;&lt;p class="Tablas"&gt; &lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 22.06%"&gt;&lt;p class="Tablas"&gt;Diciembre 2019&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 11.35pt"&gt;&lt;td valign="bottom" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 54.16%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Reserva legal&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 20.36%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;          1.402.687&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 3.4%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt; &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 22.06%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;1.402.687&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 11.35pt"&gt;&lt;td valign="bottom" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 54.16%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Reserva para protección del patrimonio&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 20.36%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt; &lt;/span&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;2.104.600.595&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 3.4%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt; &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 22.06%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2.296.422.273&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 11.35pt"&gt;&lt;td valign="bottom" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 54.16%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Reserva para crecimiento y expansión&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 20.36%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;    &lt;/span&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;197.273.423&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 3.4%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt; &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 22.06%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;197.273.423&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 11.35pt"&gt;&lt;td valign="bottom" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 54.16%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Reserva fiscal&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 20.36%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;          2.911.495&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 3.4%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt; &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 22.06%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2.911.495&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 11.35pt"&gt;&lt;td valign="bottom" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 54.16%"/&gt;&lt;td valign="bottom" style="border: none; border-bottom: double windowtext 1.5pt; height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 20.36%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;  2.306.188.200&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 3.4%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt; &lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: double windowtext 1.5pt; height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 22.06%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2.498.009.878&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoNormal"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="Notas3"&gt;Ganancia neta del año&lt;/p&gt;&lt;p class="MsoNormal"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Las&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;ganancias netas del año y dividendos sobre instrumentos de patrimonio comprendían:&lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="100%" style="border-collapse: collapse; width: 100.0%"&gt;&lt;tbody&gt;&lt;tr style="height: 2.85pt"&gt;&lt;td style="height: 2.85pt; padding: 0cm 5.4pt 0cm 5.4pt; width: 59.6%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt; &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 2.85pt; padding: 0cm 5.4pt 0cm 5.4pt; width: 18.82%"&gt;&lt;p class="Tablas"&gt;Marzo 2020&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 2.85pt; padding: 0cm 5.4pt 0cm 5.4pt; width: 3.14%"&gt;&lt;p class="Tablas"&gt; &lt;/