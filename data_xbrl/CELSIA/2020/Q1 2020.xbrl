 8.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt; -&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: dotted windowtext 1.0pt; height: 16.95pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 51.95pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 8.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt; -&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: dotted windowtext 1.0pt; height: 16.95pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 55.0pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 8.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt; -&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: dotted windowtext 1.0pt; height: 16.95pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 69.75pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 8.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;                        150.860&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoListParagraphCxSpFirst" style="margin-bottom: .0001pt; margin-left: 0cm; margin-right: 0cm; margin-top: 12.0pt; page-break-after: avoid; text-align: justify"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoListParagraphCxSpLast" style="margin-bottom: .0001pt; margin-left: 0cm; margin-right: 0cm; margin-top: 12.0pt; page-break-after: avoid; text-align: justify"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Restricciones y compromisos significativos:&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;No existen restricciones significativas sobre la capacidad de los negocios conjuntos y compañías asociadas para transferir fondos por dividendos, reembolso de préstamos, anticipos u otros. Asimismo, no se tienen compromisos no reconocidos con negocios conjuntos y compañías asociadas a 31 de marzo de 2020 y 31 de diciembre de 2019, que puedan dar lugar a salidas de efectivo u otros recursos en el futuro, tales como: aportación de fondos o recursos, compromisos de préstamos o apoyo financiero, compromisos de adquirir una participación en la asociada o negocio conjunto de otra parte.&lt;/span&gt;&lt;/p&gt;</ifrs:DisclosureOfInvestmentInAssociatesExplanatory>
  <ifrs:DisclosureOfCashAndCashEquivalentsExplanatory contextRef="p3">&lt;p class="Notas1"&gt;&lt;span class="Notas1Car"&gt;&lt;span style="text-transform: none"&gt;NOTA&lt;/span&gt;&lt;/span&gt;&lt;span&gt;9&lt;/span&gt;&lt;span class="Notas1Car"&gt;&lt;span style="text-transform: none"&gt;. EFECTIVO Y EQUIVALENTES AL EFECTIVO&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-bottom: 12.0pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;El saldo de efectivo y equivalentes al efectivo, al 31 de marzo y 31 de diciembre, comprendía:&lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="100%" style="border-collapse: collapse; width: 100.0%"&gt;&lt;tbody&gt;&lt;tr style="height: 11.35pt"&gt;&lt;td style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 58.12%"&gt;&lt;p class="Tablas"&gt;Efectivo&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 17.8%"&gt;&lt;p class="Tablas"&gt;Marzo 2020&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 5.86%"&gt;&lt;p class="Tablas"&gt; &lt;/p&gt;&lt;/td&gt;&lt;td style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 18.22%"&gt;&lt;p class="Tablas"&gt;Diciembre 2019&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 11.35pt"&gt;&lt;td style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 58.12%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Caja&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 17.8%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&