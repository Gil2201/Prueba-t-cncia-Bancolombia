.5pt; white-space: nowrap; width: 58.16%"/&gt;&lt;td valign="bottom" style="border: none; border-top: solid windowtext 1.0pt; height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 19.1%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;4.670.538.210&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 2.6%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: red"&gt; &lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="border: none; border-top: solid windowtext 1.0pt; height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 20.14%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;4.131.943.799&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoBodyTextIndent" style="margin-bottom: .0001pt; margin-left: 20.25pt; margin-right: 0cm; margin-top: 0cm"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin-bottom: .0001pt; margin-left: 38.25pt; margin-right: 0cm; margin-top: 0cm; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;(a)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Corresponde al compromiso con Integral adquirido en el 2015 en relación con la compra de Porvenir II y que se comienza a cumplir a partir del 2022 y la obligación con IBM por adquisición de licencias de SAP, desarrollos e implementación basadas en tecnología que permiten la integración de operaciones de generación, transmisión y distribución de energía mediante un centro de control unificado.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin-bottom: .0001pt; margin-left: 38.25pt; margin-right: 0cm; margin-top: 0cm; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;(b)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Corresponde a las cuentas por cobrar y por pagar de corto plazo que se presentan a su monto nominal.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin-bottom: .0001pt; margin-left: 20.25pt; margin-right: 0cm; margin-top: 0cm; text-indent: -20.25pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;(5)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;   &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Corresponde a instrumentos financieros derivados&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Las cuentas por cobrar y por pagar de corto plazo se presentan a su monto nominal.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Descripción de las variables significativas de la valoración&lt;/span&gt;&lt;/b&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;&lt;br/&gt;&lt;br/&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Las variables significativas utilizadas en las mediciones del valor razonable a 31 de marzo de 2020 y 31 diciembre de 2019, se muestran a continuación:&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="100%" style="border-collapse: collapse; width: 100.0%"&gt;&lt;tbody&gt;&lt;tr style="height: 36.0pt"&gt;&lt;td valign="bottom" style="border: none; border-bottom: solid windowtext 1.0pt; height: 36.0pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 37.04%"/&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 36.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 9.26%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Nivel Jerarquía&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 36.0pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 11.32%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Técnica de valoración&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height