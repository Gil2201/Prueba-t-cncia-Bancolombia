5pt"&gt;&lt;td style="height: 13.55pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 42.36%"/&gt;&lt;td style="height: 13.55pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 1.52%"/&gt;&lt;td style="border: none; border-bottom: double windowtext 2.25pt; height: 13.55pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 15.12%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;2.638.470.705&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: double windowtext 2.25pt; height: 13.55pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 15.12%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;2.758.455.124&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 13.55pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 1.52%"/&gt;&lt;td style="border: none; border-bottom: double windowtext 2.25pt; height: 13.55pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 12.18%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;819.008.472&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: double windowtext 2.25pt; height: 13.55pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 12.18%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;984.008.563&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoBodyTextIndent" style="margin: 0cm; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="text-align: justify"&gt;&lt;a id="_Hlk47017236"/&gt;&lt;a id="_Hlk47016869"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;La opción tarifaria es un mecanismo creado por la CREG mediante la resolución CREG 012-2020, que&lt;/span&gt;&lt;/a&gt;&lt;a id="_Hlk46911012"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;permite a los Comercializadores diferir incrementos en las tarifas&lt;/span&gt;&lt;/a&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;. &lt;a id="_Hlk46911054"&gt;Esta disposición aplica únicamente para el mercado regulado y fue motivada en los incrementos previstos por la aplicación de los nuevos cargos de distribución&lt;/a&gt;, aprobados a los operadores de red conforme a la resolución CREG 015 de 2018. La opción tiene vigencia indefinida y aplica para Celsia Tolima S.A..  A partir de la contingencia por el Covid-19, a través de la Resolución CREG 058 de 2020 las compañías Celsia Colombia S.A. y Cetsa se acogieron a la opción tarifaria.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;</ifrs:DisclosureOfRevenueExplanatory>
  <ifrs:DisclosureOfGeneralAndAdministrativeExpenseExplanatory contextRef="p3">&lt;p class="Notas1"&gt;&lt;span&gt;NOTA 16. GASTOS DE ADMINISTRACIÓN&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Los gastos de administración a 30 de septiembre comprendían:&lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="104%" style="border-collapse: collapse; width: 104.14%"&gt;&lt;tbody&gt;&lt;tr style="height: 11.35pt"&gt;&lt;td valign="bottom" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 34.68%"/&gt;&lt;td valign="bottom" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 1.54%"/&gt;&lt;td colspan="2" valign="bottom" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Acumulado&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 2.42%"/&gt;&lt;td colspan="2" valign="bottom" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Trimestre&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 11.35pt"&gt;&lt;td valign="bottom" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 34.68%"/&gt;&lt;td style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 1.54%"/&gt;&lt;td style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 16.2%"&gt;&lt;p class="MsoN