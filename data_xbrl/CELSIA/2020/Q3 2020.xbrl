"top" style="height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 3.4%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt; &lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: double windowtext 1.5pt; height: 11.35pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 22.06%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2.498.009.878&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoNormal"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="Notas3"&gt;Ganancia neta del año&lt;/p&gt;&lt;p class="MsoNormal"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Las&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;ganancias netas del año y dividendos sobre instrumentos de patrimonio comprendían:&lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="98%" style="border-collapse: collapse; width: 98.14%"&gt;&lt;tbody&gt;&lt;tr style="height: 2.85pt"&gt;&lt;td style="height: 2.85pt; padding: 0cm 5.4pt 0cm 5.4pt; width: 57.8%"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt; &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 2.85pt; padding: 0cm 5.4pt 0cm 5.4pt; width: 20.92%"&gt;&lt;p class="Tablas"&gt;Septiembre 2020&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 2.85pt; padding: 0cm 5.4pt 0cm 5.4pt; width: 2.5%"&gt;&lt;p class="Tabl