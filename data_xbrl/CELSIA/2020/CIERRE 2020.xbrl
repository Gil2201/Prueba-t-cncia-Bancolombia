ht"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.2pt; padding: 0cm 3.5pt 0cm 3.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;234.359 &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 12.2pt"&gt;&lt;td style="height: 12.2pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 337.4pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Provisiones nuevas &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.2pt; padding: 0cm 3.5pt 0cm 3.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;5.444 &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 12.2pt; padding: 0cm 3.5pt 0cm 3.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 12.2pt; padding: 0cm 3.5pt 0cm 3.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2.785 &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 12.2pt"&gt;&lt;td style="height: 12.2pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 337.4pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Recuperaciones &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 