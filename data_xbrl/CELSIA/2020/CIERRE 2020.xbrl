ns-serif; color: black"&gt;Provisión para procesos laborales y jurídicos &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="height: 13.1pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 14.05pt"/&gt;&lt;td style="height: 13.1pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 86.65pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;217.789&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="height: 13.1pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 18.05pt"/&gt;&lt;td style="height: 13.1pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 89.65pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;232.420&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 13.1pt"&gt;&lt;td style="height: 13.1pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 243.9pt"/&gt;&lt;td style="height: 13.1pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 14.05pt"/&gt;&lt;td style="height: 13.1pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 86.65pt"/&gt;&lt;td style="height: 13.1pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 18.05pt"/&gt;&lt;td style="height: 13.1pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 89.65pt"/&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoNormal" style="text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; El siguiente detalle refleja el movimiento de las provisiones:&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin: 0cm; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalT