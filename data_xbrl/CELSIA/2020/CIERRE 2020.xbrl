l" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;238.544&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 11.45pt"&gt;&lt;td valign="bottom" style="height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 271.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;A partes relacionadas (Nota 35)                                                                                                                                          &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 96.2pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;153.615&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 8.45pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: red"&gt; &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 89.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;63.796&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 11.45pt"&gt;&lt;td valign="bottom" style="height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 271.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Avances y anticipos recibidos&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 96.2pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;16.443&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 8.45pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: red"&gt; &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 89.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;28.092&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 13.6pt"&gt;&lt;td style="height: 13.6pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 271.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Otras cuentas por pagar                                                                                                                                       &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 13.6pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 96.2pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;4.801&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 13.6pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 8.45pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: red"&gt; &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 13.6pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 89.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;6.603&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 11.45pt"&gt;&lt;td valign="bottom" style="height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 271.55pt"/&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 96.2pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;799.273&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 8.45pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: red"&gt; &lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 89.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;715.440&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr