ize: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;692.408&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 8.45pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: red"&gt; &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 89.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;616.081&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 11.45pt"&gt;&lt;td style="height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 271.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;No corriente&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 96.2pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;106.865&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 8.45pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: red"&gt; &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 89.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;99.359&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 11.45pt"&gt;&lt;td valign="bottom" style="height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 271.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt; &lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 96.2pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;799.273&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 8.45pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: red"&gt; &lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="border: none; border-bottom: solid windowtext 1.0pt; height: 11.45pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 89.55pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;715.440&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoNormal"&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraph" style="margin-left: 18.0pt; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;(1)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Incluye $106.865 (2019 - $99.359) correspondiente al compromiso con Integral S.A. adquirido en el año 2015 en relación con la compra de Porvenir II; dicho compromiso se comienza a cumplir a partir del 2022 y se actualiza anualmente de acuerdo con el IPC. Incluye también otros anticipos a proveedores, depósitos entregados y anticipos de impuestos a favor.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;En 2020 se clasificaron cuentas por pagar del segmento de Centroamérica como pasivos directamente asociados con activos clasificados como mantenidos para la venta por $5.091, de conformidad con lo indicado en la nota 17.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="margin-top: 12.0pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;El periodo de crédito promedio para la compra de bienes es de 3 meses y para la compra de servicios es de 30 días. El Grupo tiene implementadas políticas de manejo de riesgo financiero para asegurar que todas las cuentas por pagar se paguen de conformidad con los términos crediticios pactados.&lt;/span&gt;&lt;/p&gt;</ifrs:DisclosureOfTradeAndOtherPayablesExplanatory>
  <ifrs:DisclosureOfRevenueExplanatory contextRef="p3">&lt;p class="MsoBodyTextIndent" style="margin-left: 0cm; text-align: justify"&gt;&lt;b&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif; text-transform: uppercase"&gt;NOTA 24. INGRESOS de actividades ordinarias&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin: 0cm; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Celsia y sus compañías relacionadas generan ingresos principalmente a partir de la venta de energía&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;a través de contratos bilaterales al mercado regulado&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;y&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;no regulado,&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;de&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;la Bolsa, del servicio&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;de&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;regulación secundaria de frecuencia (AGC) y del Cargo&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;por&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Confiabilidad&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="margin: 0cm; margin-bottom: .0001pt; text-align: justify"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Los ingresos de actividades ordinarias por las actividades de prestación de servicios públicos al 31 de diciembre comprendían:&lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="621" style="border-collapse: collapse; margin-left: 3.5pt; width: 465.6pt"&gt;&lt;tbody&gt;&lt;tr style="height: 11.8pt"&gt;&lt;td valign="bottom" style="height: 11.8pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 327.3pt"/&gt;&lt;td valign="bottom" style="height: 11.8pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"/&gt;&lt;td valign="bottom" style="height: 11.8pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;2020&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="height: 11.8pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"/&gt;&lt;td valign="bottom" style="height: 11.8pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;2019&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 9.75pt"&gt;&lt;td colspan="2" valign="bottom" style="height: 9.75pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Comercialización de energía eléctrica en el mercado regulado y no regulado (1)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 9.75pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;1.847.796&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="height: 9.75pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"/&gt;&lt;td style="height: 9.75pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;  1.458.144&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 11.8pt"&gt;&lt;td valign="bottom" style="height: 11.8pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 327.3pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Venta de energía eléctrica en Bolsa&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="height: 11.8pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"/&gt;&lt;td valign="bottom" style="height: 11.8pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;    &lt;/span&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;725.601&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="height: 11.8pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"/&gt;&lt;td valign="bottom" style="height: 11.8pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;