odas las demás presunciones constantes.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal" style="line-height: 12.95pt"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Sensibilidades Plan Pensiones de Jubilación&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" style="border-collapse: collapse; margin-left: 5.4pt"&gt;&lt;tbody&gt;&lt;tr style="height: .05pt"&gt;&lt;td valign="top" style="background: white; height: .05pt; padding: 0cm 5.4pt 0cm 5.4pt; width: 264.8pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Sensibilidades&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="background: white; height: .05pt; padding: 0cm 5.4pt 0cm 5.4pt; width: 88.3pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2020&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="background: white; height: .05pt; padding: 0cm 5.4pt 0cm 5.4pt; width: 88.3pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;2019&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: .05pt"&gt;&lt;td valign="top" style="background: white; height: .05pt; padding: 0cm 5.4pt 0cm 5.4pt; width: 264.8pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Tasa de Descuento ( -100 pb)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="top" style="background: white; height: .05pt; padding: 0cm 5.4pt 0cm 5.4pt; width: 88.3pt"&gt;&lt;p class="MsoN