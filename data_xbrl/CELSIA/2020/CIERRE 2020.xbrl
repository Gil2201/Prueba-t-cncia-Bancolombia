ns-serif"&gt;         (30.325)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 1.2pt"&gt;&lt;td style="height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Otros gastos (6)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"/&gt;&lt;td valign="bottom" style="height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;         (8.041)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"/&gt;&lt;td valign="bottom" style="height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;         (10.675)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 1.2pt"&gt;&lt;td style="height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Total otros gastos (2)&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"/&gt;&lt;td valign="bottom" style="border-bottom: solid windowtext 1.0pt; border-left: none; border-right: none; border-top: solid windowtext 1.0pt; height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;       (27.472)&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"/&gt;&lt;td valign="bottom" style="border-bottom: solid windowtext 1.0pt; border-left: none; border-right: none; border-top: solid windowtext 1.0pt; height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;       (134.531)&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 1.2pt"&gt;&lt;td style="height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;Total otros gastos, neto&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"/&gt;&lt;td style="border: none; border-bottom: double windowtext 2.25pt; height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;22.149&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style="height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"/&gt;&lt;td style="border: none; border-bottom: double windowtext 2.25pt; height: 1.2pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;524.325&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p class="MsoNormal"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt; &lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Otros Ingresos&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 105%; margin-bottom: .0001pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; page-break-after: avoid; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;(1)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;En 2019 debido a los vínculos estratégicos con Caoba Inversiones S.A.S. del resultado de la venta del negocio de transmisión para la conformación de su estructura de capital.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 105%; margin-bottom: .0001pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; page-break-after: avoid; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;(2)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;En 2019 corresponde a la utilidad por la venta de Zona Franca Celsia en septiembre de 2019 y algunos activos asociados a la operación de dicha inversión, en 2020 se presentó ajuste por la venta de Zona Franca Celsia&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 105%; margin-bottom: .0001pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; page-break-after: avoid; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;(3)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;En 2020 se presenta utilidad por venta de activos eléctricos de transmisión y distribución de los niveles de tensión 3 y 4 y por la construcción de activos bajo un contrato de BOT a la sociedad Caoba Inversiones SAS, ubicados en los departamentos del Tolima.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 105%; margin-bottom: .0001pt; margin-left: 18.0pt; margin-right: 0cm; margin-top: 0cm; page-break-after: avoid; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;(4)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Corresponde a la recuperación de provisión de litigios jurídicos que han resultado a favor de la compañía por $13.006.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoNormal"&gt;&lt;b&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Otros Egresos:&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 105%; margin-bottom: .0001pt; margin-left: 36.0pt; margin-right: 0cm; margin-top: 0cm; page-break-after: avoid; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; text-transform: uppercase"&gt;(1)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Incluye principalmente donaciones realizadas a la Fundación Grupo Argos por $4.600 (2019 - $4.400); Fundación Celsia Colombia por $7.485 (2019 - $4.483); Corporación Antioquia Presente $550 y Resguardo Yaporogos $854&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 105%; margin-bottom: .0001pt; margin-left: 36.0pt; margin-right: 0cm; margin-top: 0cm; page-break-after: avoid; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; text-transform: uppercase"&gt;(2)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Corresponde a la baja de activos en Zona Franca Celsia por el siniestro reconocido en junio del 2019.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 105%; margin-bottom: .0001pt; margin-left: 36.0pt; margin-right: 0cm; margin-top: 0cm; page-break-after: avoid; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; text-transform: uppercase"&gt;(3)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Reconocimiento a pérdida por baja de otros intangibles correspondiente a estudios de Porvenir III&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 105%; margin-bottom: .0001pt; margin-left: 36.0pt; margin-right: 0cm; margin-top: 0cm; page-break-after: avoid; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; text-transform: uppercase"&gt;(4)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Deterioro de Inversiones en Porvenir II producto de la valoración de la inversión con ocasión de la corrida en entrada en operación del proyecto motivada por la suspensión temporal de la licencia ambiental.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoBodyTextIndent" style="line-height: 105%; margin-bottom: .0001pt; margin-left: 36.0pt; margin-right: 0cm; margin-top: 0cm; page-break-after: avoid; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif; text-transform: uppercase"&gt;(5)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; line-height: 105%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Deterioro de propiedades, planta y equipo e intangibles: En 2019 teniendo en cuenta la situación operacional de Bahía Las Minas por la terminación de los contratos existentes, la Matriz decidió deteriorar la inversión.&lt;/span&gt;&lt;/p&gt;&lt;p class="MsoListParagraph" style="line-height: normal; margin-bottom: .0001pt; page-break-after: avoid; text-align: justify; text-indent: -18.0pt"&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;(6)&lt;span style="font: 7.0pt &amp;quot;Times New Roman&amp;quot;"&gt;  &lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 10.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Incluye gastos no deducibles, multas y sanciones, gastos legales, impuestos asumidos, y a reconocimiento de baja de inventarios en Centroamérica.&lt;/span&gt;&lt;/p&gt;</ifrs:DisclosureOfOtherOperatingIncomeExpenseExplanatory>
  <ifrs:DisclosureOfGeneralAndAdministrativeExpenseExplanatory contextRef="p3">&lt;p class="MsoNormal" style="page-break-after: avoid"&gt;&lt;b&gt;&lt;span style="font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;NOTA 27. GASTOS DE ADMINISTRACIÓN&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class="MsoNormal"&gt;&lt;span style="font-size: 10.0pt; line-height: 107%; font-family: &amp;quot;Arial&amp;quot;,sans-serif"&gt;Los gastos de administración al 31 de diciembre comprendían:&lt;/span&gt;&lt;/p&gt;&lt;table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="607" style="border-collapse: collapse; margin-left: 3.5pt; width: 455.15pt"&gt;&lt;thead&gt;&lt;tr style="height: 12.8pt"&gt;&lt;td valign="bottom" style="height: 12.8pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 269.95pt"/&gt;&lt;td style="height: 12.8pt; padding: 0cm 3.5pt 0cm 3.5pt; width: 16.05pt"/&gt;&lt;td style="height: 12.8pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 77.3pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;2020&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;td valign="bottom" style="height: 12.8pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 14.55pt"/&gt;&lt;td style="height: 12.8pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 77.3pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt; text-align: right"&gt;&lt;b&gt;&lt;span style="font-size: 9.0pt; font-family: &amp;quot;Arial&amp;quot;,sans-serif; color: black"&gt;2019&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr style="height: 12.8pt"&gt;&lt;td style="height: 12.8pt; padding: 0cm 3.5pt 0cm 3.5pt; white-space: nowrap; width: 269.95pt"&gt;&lt;p class="MsoNormal" style="line-height: normal; margin-bottom: .0001pt"&gt;&lt;span styl