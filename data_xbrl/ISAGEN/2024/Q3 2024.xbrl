  <ifrs:FinancialAssetsHeldForManagingLiquidityRisk contextRef="id2897" unitRef="id2249" decimals="INF">0</ifrs:FinancialAssetsHeldForManagingLiquidityRisk>
  <ifrs:FinancialAssetsHeldForManagingLiquidityRisk contextRef="id2898" unitRef="id2249" decimals="INF">0</ifrs:FinancialAssetsHeldForManagingLiquidityRisk>
