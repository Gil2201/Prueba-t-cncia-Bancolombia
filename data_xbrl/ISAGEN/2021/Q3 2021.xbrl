  <ifrs:ExplanationOfFactAndBasisForPreparationOfFinancialStatementsWhenNotGoingConcernBasis contextRef="id4121">NA</ifrs:ExplanationOfFactAndBasisForPreparationOfFinancialStatementsWhenNotGoingConcernBasis>
  <ifrs:ExplanationWhyFinancialStatementsNotPreparedOnGoingConcernBasis contextRef="id4121">NA</ifrs:ExplanationWhyFinancialStatementsNotPreparedOnGoingConcernBasis>
