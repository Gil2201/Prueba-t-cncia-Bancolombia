  <ifrs:ExplanationOfFactAndBasisForPreparationOfFinancialStatementsWhenNotGoingConcernBasis contextRef="id17">NA</ifrs:ExplanationOfFactAndBasisForPreparationOfFinancialStatementsWhenNotGoingConcernBasis>
  <ifrs:ExplanationWhyFinancialStatementsNotPreparedOnGoingConcernBasis contextRef="id17">NA</ifrs:ExplanationWhyFinancialStatementsNotPreparedOnGoingConcernBasis>
