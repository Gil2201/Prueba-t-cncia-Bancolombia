  <ifrs:DescriptionOfUncertaintiesOfEntitysAbilityToContinueAsGoingConcern contextRef="id4">NA</ifrs:DescriptionOfUncertaintiesOfEntitysAbilityToContinueAsGoingConcern>
  <ifrs:ExplanationOfFactAndBasisForPreparationOfFinancialStatementsWhenNotGoingConcernBasis contextRef="id4">NA</ifrs:ExplanationOfFactAndBasisForPreparationOfFinancialStatementsWhenNotGoingConcernBasis>
  <ifrs:ExplanationWhyFinancialStatementsNotPreparedOnGoingConcernBasis contextRef="id4">NA</ifrs:ExplanationWhyFinancialStatementsNotPreparedOnGoingConcernBasis>
