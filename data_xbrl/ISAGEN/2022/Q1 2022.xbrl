  <co-sfc-core:CuentasCobrarPartesRelacionadasAsociadasCorrientes contextRef="id6166" unitRef="id6168" decimals="INF">17582581</co-sfc-core:CuentasCobrarPartesRelacionadasAsociadasCorrientes>
