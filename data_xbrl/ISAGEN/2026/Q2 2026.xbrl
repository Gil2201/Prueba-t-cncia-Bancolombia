  <ifrs:DividendsRecognisedAsDistributionsToOwnersOfParentRelatingToCurrentYear contextRef="id47" unitRef="id53" decimals="INF">640428542673</ifrs:DividendsRecognisedAsDistributionsToOwnersOfParentRelatingToCurrentYear>
