  <ifrs:ExplanationOfFactAndBasisForPreparationOfFinancialStatementsWhenNotGoingConcernBasis contextRef="id7">NA</ifrs:ExplanationOfFactAndBasisForPreparationOfFinancialStatementsWhenNotGoingConcernBasis>
  <ifrs:ExplanationWhyFinancialStatementsNotPreparedOnGoingConcernBasis contextRef="id7">NA</ifrs:ExplanationWhyFinancialStatementsNotPreparedOnGoingConcernBasis>
