  <ifrs:DescriptionOfUncertaintiesOfEntitysAbilityToContinueAsGoingConcern contextRef="id8">NA</ifrs:DescriptionOfUncertaintiesOfEntitysAbilityToContinueAsGoingConcern>
  <ifrs:ExplanationOfFactAndBasisForPreparationOfFinancialStatementsWhenNotGoingConcernBasis contextRef="id8">NA</ifrs:ExplanationOfFactAndBasisForPreparationOfFinancialStatementsWhenNotGoingConcernBasis>
  <ifrs:ExplanationWhyFinancialStatementsNotPreparedOnGoingConcernBasis contextRef="id8">NA</ifrs:ExplanationWhyFinancialStatementsNotPreparedOnGoingConcernBasis>
