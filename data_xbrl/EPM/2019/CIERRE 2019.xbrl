  <ifrs:DescriptionOfHowManagementDeterminesConcentrations contextRef="c8879">NA</ifrs:DescriptionOfHowManagementDeterminesConcentrations>
<!--Cell=[$L$17]; Schedule=[822390-7]; Table(s)=[2]; ShortName=[-]-->
