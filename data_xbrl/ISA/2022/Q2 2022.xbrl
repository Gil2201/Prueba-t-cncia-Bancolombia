  <ifrs:DepreciationPropertyPlantAndEquipment decimals="0" contextRef="Periodo_ifrs_DisclosureOfPropertyPlantAndEquipmentTable_MotorVehiclesMember_ifrs_AccumulatedDepreciationAmortisationAndImpairmentMember_6_25_ACT" unitRef="COP">6846036</ifrs:DepreciationPropertyPlantAndEquipment>
