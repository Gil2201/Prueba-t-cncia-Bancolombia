  <ifrs:DepreciationPropertyPlantAndEquipment decimals="0" contextRef="Periodo_ifrs_DisclosureOfPropertyPlantAndEquipmentTable_OtherPropertyPlantAndEquipmentMember_ifrs_CarryingAmountMember_6_65_ACT" unitRef="COP">94234250</ifrs:DepreciationPropertyPlantAndEquipment>
