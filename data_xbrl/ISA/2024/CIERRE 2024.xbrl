  <ifrs:DepreciationPropertyPlantAndEquipment decimals="0" contextRef="Periodo_ifrs_DisclosureOfPropertyPlantAndEquipmentTable_OtherPropertyPlantAndEquipmentMember_ifrs_AccumulatedDepreciationAmortisationAndImpairmentMember_6_64_ACT" unitRef="COP">201783610</ifrs:DepreciationPropertyPlantAndEquipment>
  <ifrs:DepreciationPropertyPlantAndEquipment decimals="0" contextRef="Periodo_ifrs_DisclosureOfPropertyPlantAndEquipmentTable_OtherPropertyPlantAndEquipmentMember_ifrs_CarryingAmountMember_6_65_ACT" unitRef="COP">201783610</ifrs:DepreciationPropertyPlantAndEquipment>
