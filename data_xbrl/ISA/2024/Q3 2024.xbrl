  <ifrs:DepreciationPropertyPlantAndEquipment decimals="0" contextRef="Periodo_ifrs_DisclosureOfPropertyPlantAndEquipmentTable_OtherPropertyPlantAndEquipmentMember_ifrs_CarryingAmountMember_6_65_ACT" unitRef="COP">145516623</ifrs:DepreciationPropertyPlantAndEquipment>
