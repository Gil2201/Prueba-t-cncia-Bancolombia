  <ifrs:DisclosureOfOtherLiabilitiesExplanatory contextRef="_ctx0">VER FORMATO 800100</ifrs:DisclosureOfOtherLiabilitiesExplanatory>
  <ifrs:DisclosureOfOtherNoncurrentAssetsExplanatory contextRef="_ctx0">VER FORMATO 800100</ifrs:DisclosureOfOtherNoncurrentAssetsExplanatory>
  <ifrs:DisclosureOfOtherNoncurrentLiabilitiesExplanatory contextRef="_ctx0">VER FORMATO 800100</ifrs:DisclosureOfOtherNoncurrentLiabilitiesExplanatory>
