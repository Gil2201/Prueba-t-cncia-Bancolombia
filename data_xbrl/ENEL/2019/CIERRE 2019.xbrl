  <ifrs:DisclosureOfOtherCurrentLiabilitiesExplanatory contextRef="_ctx0">VER FORMATO 800100</ifrs:DisclosureOfOtherCurrentLiabilitiesExplanatory>
  <ifrs:DisclosureOfOtherLiabilitiesExplanatory contextRef="_ctx0">VER FORMATO 800100</ifrs:DisclosureOfOtherLiabilitiesExplanatory>
