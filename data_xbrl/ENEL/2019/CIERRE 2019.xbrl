  <ifrs:DisclosureOfOtherOperatingIncomeExpenseExplanatory contextRef="_ctx0">VER FORMATO 800200</ifrs:DisclosureOfOtherOperatingIncomeExpenseExplanatory>
  <ifrs:DisclosureOfOtherOperatingIncomeExplanatory contextRef="_ctx0">VER FORMATO 800200</ifrs:DisclosureOfOtherOperatingIncomeExplanatory>
